#!/bin/sh

echo "---------------------------------------"
echo "Iniciando Hooks de Pre-Commit..."
echo "---------------------------------------"

# 1. Se estiver na branch Laravel (master) ou ambiente PHP com composer
if [ -f "composer.json" ] && command -v composer >/dev/null 2>&1; then
    echo "[1/2] Rodando Laravel Pint..."
    composer lint
    PINT_STATUS=$?

    if [ $PINT_STATUS -ne 0 ]; then
        echo "[ERRO] Laravel Pint encontrou problemas de formatacao no codigo."
        echo "Dica: rode './vendor/bin/pint' para corrigir automaticamente."
        echo "Commit abortado."
        exit 1
    fi
    echo "Pint OK."

    echo "[2/2] Rodando Larastan Analise Estatica..."
    composer analyse
    STAN_STATUS=$?

    if [ $STAN_STATUS -ne 0 ]; then
        echo "[ERRO] Larastan encontrou falhas no codigo PHP."
        echo "Commit abortado."
        exit 1
    fi
    echo "Larastan OK."
fi

# 2. Se for o frontend / PWA (index.html)
if [ -f "index.html" ]; then
    echo "Verificando integridade e atualizando versao do frontend..."

    # Garante que não existem marcadores de conflito git esquecidos
    if grep -En "^(<<<<<<<|=======|>>>>>>>)" js/*.js cloud-sync.js app-modules.js index.html 2>/dev/null; then
        echo "[ERRO] Marcadores de conflito git detectados! Resolva os conflitos antes de commitar."
        exit 1
    fi

    # Extrai versão atual
    OLD_VERSION=$(grep -o 'meta name="app-version" content="[^"]*"' index.html | head -n 1 | sed 's/.*content="//; s/".*//')

    # Gera nova versão automática com Data e Horário (ex: 20261024-1245)
    NEW_VERSION=$(date +"%Y%m%d-%H%M")
    if [ "$OLD_VERSION" = "$NEW_VERSION" ]; then
        NEW_VERSION=$(date +"%Y%m%d-%H%M%S")
    fi

    if [ -n "$OLD_VERSION" ] && [ "$OLD_VERSION" != "$NEW_VERSION" ]; then
        echo "[AUTO-VERSION] Atualizando versao com data e horario: $OLD_VERSION -> $NEW_VERSION"
        # Substitui na meta e em todas as query strings ?v= do index.html e no sw.js
        sed -i "s/$OLD_VERSION/$NEW_VERSION/g" index.html
        git add index.html
        if [ -f "sw.js" ]; then
            sed -i "s/SW_BUILD_VERSION = '[^']*'/SW_BUILD_VERSION = '$NEW_VERSION'/g" sw.js
            git add sw.js
        fi
        echo "[AUTO-VERSION] index.html e sw.js atualizados e prontos para commit (v$NEW_VERSION)."
    else
        echo "Versao atual do app: $OLD_VERSION"
    fi

    echo "Integridade web e versao OK."
fi

echo "Pronto pra commit. Todos os checks validos."
exit 0
